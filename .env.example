# OpenAI 연결은 후속 RAG·챗봇 단계에서 사용합니다.
OPENAI_API_KEY=

# 국가법령정보 공동활용 API의 OC(인증 식별자)입니다.
# 판례 수집·재수집 명령은 이 변수만 사용합니다.
LAW_OPEN_API_OC=

# 선택 사항: PATH에서 Tesseract를 찾지 못하는 Windows 환경에서 지정합니다.
TESSERACT_CMD=

# 선택 사항: 기획서 PDF 생성기가 한국어 TTF 글꼴을 자동으로 찾지 못할 때 지정합니다.
KOREAN_FONT_PATH=

# 선택 사항: 법령·판례 관계형 DB와 Chroma 인덱스의 기본 로컬 경로를 변경합니다.
JEONSEON_DATABASE_PATH=
JEONSEON_CHROMA_PATH=
